<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>StandaloneLifecycleProbe</AssemblyName>
    <NuSource Condition="'$(NuSource)' == ''">../../source</NuSource>
    <Arm Condition="'$(Arm)' == ''">mmcc</Arm>
    <DefineConstants Condition="'$(Arm)' == 'mmcc'">$(DefineConstants);MMCC</DefineConstants>
    <DefineConstants Condition="'$(Arm)' == 'imsim'">$(DefineConstants);IMSIM</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Common.fs" />
    <Compile Include="Probe.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(NuSource)/Projects/Breakout Mmcc/Breakout Mmcc.fsproj" Condition="'$(Arm)' == 'mmcc'" />
    <ProjectReference Include="$(NuSource)/Projects/Breakout ImSim/Breakout ImSim.fsproj" Condition="'$(Arm)' == 'imsim'" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="AssimpNet"><HintPath>$(NuSource)/Nu/Nu.Dependencies/AssimpNet/netstandard2.1/AssimpNet.dll</HintPath></Reference>
    <Reference Include="BulletSharp"><HintPath>$(NuSource)/Nu/Nu.Dependencies/BulletSharpPInvoke/netstandard2.1/BulletSharp.dll</HintPath></Reference>
    <Reference Include="OpenGL.Net"><HintPath>$(NuSource)/Nu/Nu.Dependencies/OpenGL.NET/lib/netcoreapp2.2/OpenGL.Net.dll</HintPath></Reference>
    <Reference Include="TiledSharp"><HintPath>$(NuSource)/Nu/Nu.Dependencies/TiledSharp/lib/netstandard2.0/TiledSharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
